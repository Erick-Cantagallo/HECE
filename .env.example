# Copy this file to .env and adjust. The real .env is git-ignored.

# Local Ollama model used by every agent (download it first: `ollama pull qwen3:4b-instruct-2507-q4_K_M`).
# Chosen with hece-benchmark; `llama3` also works but let more law-breaking ideas through (benchmarks/RESULTS.md).
MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M

# How many times the Synthesizer may retry when the LLM returns malformed JSON.
MAX_RETRIES=3
